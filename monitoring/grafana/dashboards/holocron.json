      "datasource": {
        "type": "prometheus",
        "uid": "holocron-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(holocron_llm_prompt_characters_total[$__rate_interval])) / clamp_min(sum(rate(holocron_llm_requests_total[$__rate_interval])), 1e-9)",
