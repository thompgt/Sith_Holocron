# Base URL of the FastAPI backend. Copy to .env.local and edit to point the UI
# at a backend that is not on localhost:8000.
#
# Vite inlines VITE_-prefixed variables into the built bundle, so this value is
# public. Never put a secret here.
#
# Whatever origin the UI is served from must also be listed in the backend's
# HOLOCRON_ALLOWED_ORIGINS, or the browser will block the request.
VITE_API_URL=http://localhost:8000
